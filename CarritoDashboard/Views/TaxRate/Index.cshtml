@{
    ViewData["Title"] = "Tax Rates";
}

<div class="module" id="module-tax-rates">
    <div class="module-header">
        <div>
            <div class="search-bar">
                <i style="width: 20px;" data-lucide="search"></i>
                <input type="text" placeholder="Search tax rates..." id="taxRateSearch">
            </div>
        </div>
        <div class="module-header-right">
            <select class="form-control" id="filterStorekeeper" data-search="true" style="min-width: 170px;">
                <option value="">Loading Storekeepers...</option>
            </select>

            <button id="btnAddNewTaxRate" class="btn-primary">
                <i style="width: 18px;" data-lucide="plus"></i>
                Add Tax Rate
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="taxRatesTable">
            <thead>
                <tr>
                    <th>Tax Name</th>
                    <th>Rate (%)</th>
                    <th>Created At</th>
                    <th>Last Updated</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<template id="taxRateFormTemplate">
    <form id="frmTaxRate">
        <div class="form-group">
            <label>Tax Name <span style="color: red;">*</span></label>
            <input type="text" id="taxName" placeholder="e.g. GST, Sales Tax, VAT" required>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label>Rate (%) <span style="color: red;">*</span></label>
            <input type="number" id="taxRateValue" step="0.01" min="0" max="100" placeholder="e.g. 5, 10, 16.5" required>
        </div>
    </form>
</template>

@section scripts {
    <script src="~/views-js/taxRates.js" asp-append-version="true"></script>
}

