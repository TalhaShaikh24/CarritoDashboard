<link href="~/css/file-uploader.css" rel="stylesheet" />

<div class="module" id="module-admins">
    <div class="module-header">
        <div>
            <div class="search-bar">
                <i style="width: 20px;" data-lucide="search"></i>
                <input type="text" placeholder="Search admins..." id="adminSearch">
            </div>
        </div>
        <button id="btnAddNewAdmin" class="btn-primary">
            <i style="width: 18px;" data-lucide="plus"></i>
            Add Admin
        </button>
    </div>

    <div class="table-container">
        <table class="data-table" id="adminsTable">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Designation</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<template id="adminFormTemplate">
    <form id="frmAddNewAdmin">
        <div class="form-row">
        <div class="form-group">
            <label>Full Name <span style="color: red;">*</span></label>
            <input type="text" id="admFullName" placeholder="John Doe" required>
        </div>
        <div class="form-group">
            <label>Username <span style="color: red;">*</span></label>
            <input type="text" id="admUsername" placeholder="admin.john" required>
        </div>
        </div>
        <div class="form-group">
            <label>Password <span style="color: red;">*</span></label>
            <input type="password" id="admPassword" placeholder="Strong password" required>
        </div>
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="admEmail" placeholder="admin@example.com">
        </div>
        <div class="form-group">
            <label>Phone <span style="color: red;">*</span></label>
            <input type="tel" id="admPhone" placeholder="+92 3XX XXXXXXX" required>
        </div>
        <div class="form-group">
            <label>Designation <span style="color: red;">*</span></label>
            <input type="text" id="admDesignation" placeholder="Super Admin / Manager" required>
        </div>
        <div class="form-group">
            <label>Status</label>
            <select id="admIsActive">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
    </form>
</template>

@section scripts {
    <script src="~/views-js/admins.js"></script>
}