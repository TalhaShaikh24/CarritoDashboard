@{
    ViewData["Title"] = "Activity Log";
}

<style>
    /* KPI boxes: the shared .dash-kpi-grid is built for the Dashboard's 6
       cards; this page has 4, so stretch them across the full row */
    #module-activity-log .dash-kpi-grid {
        grid-template-columns: repeat(4, 1fr);
    }

    @@media (max-width: 1280px) {
        #module-activity-log .dash-kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        #module-activity-log .dash-kpi-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Filters: let the row wrap instead of crushing the controls, and give
       each custom-select a fixed width (the width belongs on the plugin's
       wrapper, which sits right after the hidden native select) */
    #module-activity-log .module-header-right {
        flex-wrap: wrap;
    }

    #module-activity-log .module-header-right .custom-select-wrapper {
        flex: 0 0 auto;
    }

    #filterActivityUser + .custom-select-wrapper {
        width: 200px;
    }

    #filterActivityLevel + .custom-select-wrapper {
        width: 160px;
    }

    #filterActivityRequestType + .custom-select-wrapper {
        width: 210px;
    }

    #module-activity-log .custom-select-trigger,
    #module-activity-log .custom-select-trigger span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #module-activity-log .datepicker-dropdown-wrapper {
        flex: 0 0 auto;
    }
</style>

<div class="module" id="module-activity-log">
    <div class="module-header">
        <div class="search-bar">
            <i style="width: 20px;" data-lucide="search"></i>
            <input type="text" placeholder="Search by user, ip address, device id..." id="activityLogSearch">
        </div>

        <div class="module-header-right">
            <select class="form-control" id="filterActivityUser">
                <option value="all">All Users</option>
            </select>

            <select class="form-control" id="filterActivityLevel">
                <option value="all">All Log Levels</option>
                <option value="Success">Success</option>
                <option value="Error">Error</option>
                <option value="Warning">Warning</option>
            </select>

            <select class="form-control" id="filterActivityRequestType">
                <option value="all">All Endpoints</option>
            </select>

            <button id="activityDateRange" class="datepicker-trigger" type="button">
                <i data-lucide="calendar"></i>
                <span class="date-text">Select Date Range</span>
            </button>

            <button id="btnClearActivityFilters" class="btn-outline">
                <i style="width: 16px;" data-lucide="x"></i>
                Clear
            </button>
        </div>
    </div>

    <div class="dash-kpi-grid">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Total Activities</span>
                <i class="kpi-icon" data-lucide="activity"></i>
            </div>
            <div class="kpi-value" id="statTotalLogs">0</div>
            <div class="kpi-foot">
                <span>Logged system events</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Successful</span>
                <i class="kpi-icon" data-lucide="circle-check"></i>
            </div>
            <div class="kpi-value" id="statSuccessLogs">0</div>
            <div class="kpi-foot">
                <span>Completed without error</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Errors</span>
                <i class="kpi-icon" data-lucide="circle-x"></i>
            </div>
            <div class="kpi-value" id="statErrorLogs">0</div>
            <div class="kpi-foot">
                <span>Issues requiring attention</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Warnings</span>
                <i class="kpi-icon" data-lucide="triangle-alert"></i>
            </div>
            <div class="kpi-value" id="statWarningLogs">0</div>
            <div class="kpi-foot">
                <span>Warnings requiring attention</span>
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="activityLogTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th style="width: 130px;">IP Address</th>
                    <th style="width: 130px;">Device Id</th>
                    <th>Request Type</th>
                    <th style="width: 120px;">Status</th>
                    <th style="width: 180px;">Timestamp</th>
                    <th style="width: 100px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/views-js/activityLog.js"></script>
}
