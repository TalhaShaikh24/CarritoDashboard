@{
    ViewData["Title"] = "Suppliers";
}

<div class="module" id="module-suppliers">
    <div class="module-header">
        <div>
            <div class="search-bar">
                <i style="width: 20px;" data-lucide="search"></i>
                <input type="text" placeholder="Search suppliers..." id="supplierSearch">
            </div>
        </div>
        <div class="module-header-right">
            <select class="form-control" id="filterStorekeeper" data-search="true" style="min-width: 170px;">
                <option value="">Loading Storekeepers...</option>
            </select>

            <button id="btnAddNewSupplier" class="btn-primary">
                <i style="width: 18px;" data-lucide="plus"></i>
                Add Supplier
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="suppliersTable">
            <thead>
                <tr>
                    <th>Supplier Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Created At</th>
                    <th>Last Updated</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<template id="supplierFormTemplate">
    <form id="frmSupplier">
        <div class="form-group">
            <label>Supplier Name <span style="color: red;">*</span></label>
            <input type="text" id="supName" placeholder="e.g. Al-Madina Wholesale" required>
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label>Phone Number</label>
            <input type="tel" id="supPhone" placeholder="e.g. +92 300 1234567">
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label>Email Address</label>
            <input type="email" id="supEmail" placeholder="e.g. supplier@domain.com">
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label>Address</label>
            <textarea id="supAddress" rows="2" placeholder="e.g. Shop #12, Wholesale Market, Karachi" style="width: 100%; resize: vertical;"></textarea>
        </div>
    </form>
</template>

@section scripts {
    <script src="~/views-js/suppliers.js"></script>
}
