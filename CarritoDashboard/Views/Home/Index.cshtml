@{
    ViewData["Title"] = "Dashboard";
}

<div class="module" id="module-dashboard">
    <!-- Compact Top Bar -->
    <div class="dash-top-bar">
        <div class="dash-title-group">
            <h2 class="dash-page-heading">Platform Overview</h2>
            <span class="dash-live-indicator">
                <span class="dash-dot"></span> Live
            </span>
        </div>

        <div class="dash-filters">
            <select id="cityFilter" class="chart-select form-control" data-custom-select data-placeholder="All Cities" style="width: 130px;">
                <option value="All Cities">All Cities</option>
            </select>

            <button id="dashboardDateRange" class="datepicker-trigger" type="button">
                <i data-lucide="calendar"></i>
                <span class="date-text">Select Date Range</span>
            </button>

            <button id="btnApply" class="btn-compact-apply" type="button">Apply</button>
            <button id="btnClear" class="btn-compact-clear" type="button">Reset</button>
        </div>
    </div>

    <!-- Compact KPI Cards -->
    <div class="dash-kpi-grid">
        <!-- Total Revenue -->
        <div class="kpi-card" id="box-revenue">
            <div class="kpi-top">
                <span class="kpi-label">Total Revenue</span>
                <i class="kpi-icon" data-lucide="wallet"></i>
            </div>
            <div class="kpi-value" id="stat-revenue">Rs 0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green">Gross sales</span>
            </div>
        </div>

        <!-- Total Purchase -->
        <div class="kpi-card" id="box-purchase">
            <div class="kpi-top">
                <span class="kpi-label">Total Purchase</span>
                <i class="kpi-icon" data-lucide="shopping-cart"></i>
            </div>
            <div class="kpi-value" id="stat-purchase">Rs 0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-orange">Gross purchases</span>
            </div>
        </div>

        <!-- Total Purchase Invoies -->
        <div class="kpi-card" id="box-purchase-invoices">
            <div class="kpi-top">
                <span class="kpi-label">Purchase Invoices</span>
                <i class="kpi-icon" data-lucide="file-text"></i>
            </div>
            <div class="kpi-value" id="stat-purchase-invoices">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-orange">Total purchase invoices</span>
            </div>
        </div>

        <!-- Platform Commission -->
        <div class="kpi-card" id="box-commission">
            <div class="kpi-top">
                <span class="kpi-label">Commission</span>
                <i class="kpi-icon" data-lucide="percent"></i>
            </div>
            <div class="kpi-value" id="stat-commission">Rs 0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-orange">Platform share</span>
            </div>
        </div>

        <!-- Active Customers -->
        <div class="kpi-card" id="box-customers">
            <div class="kpi-top">
                <span class="kpi-label">Customers</span>
                <i class="kpi-icon" data-lucide="users"></i>
            </div>
            <div class="kpi-value" id="stat-customers">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green">Active buyers</span>
            </div>
        </div>

        <!-- Orders Delivered -->
        <div class="kpi-card" id="box-orders">
            <div class="kpi-top">
                <span class="kpi-label">Orders</span>
                <i class="kpi-icon" data-lucide="package-check"></i>
            </div>
            <div class="kpi-value" id="stat-orders">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-orange" id="stat-canceled-label">0 Canceled</span>
            </div>
        </div>

        <!-- Average Order Value -->
        <div class="kpi-card" id="box-average-order-value">
            <div class="kpi-top">
                <span class="kpi-label">Avg Order Value</span>
                <i class="kpi-icon" data-lucide="chart-no-axes-combined"></i>
            </div>
            <div class="kpi-value" id="stat-average-order-value">Rs 0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green">Average Order Value</span>
            </div>
        </div>

        <!-- Total Products -->
        <div class="kpi-card" id="box-products">
            <div class="kpi-top">
                <span class="kpi-label">My Products</span>
                <i class="kpi-icon" data-lucide="boxes"></i>
            </div>
            <div class="kpi-value" id="stat-products">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green">Active Products</span>
            </div>
        </div>

        <!-- Active Stores -->
        <div class="kpi-card" id="box-storekeepers">
            <div class="kpi-top">
                <span class="kpi-label">Stores</span>
                <i class="kpi-icon" data-lucide="store"></i>
            </div>
            <div class="kpi-value" id="stat-storekeepers">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green" id="stat-online-storekeepers-label">0 Online</span>
            </div>
        </div>

        <!-- Active Riders -->
        <div class="kpi-card" id="box-riders">
            <div class="kpi-top">
                <span class="kpi-label">Riders</span>
                <i class="kpi-icon" data-lucide="bike"></i>
            </div>
            <div class="kpi-value" id="stat-riders">0</div>
            <div class="kpi-foot">
                <span class="kpi-badge-green" id="stat-online-riders-label">0 Online</span>
            </div>
        </div>
    </div>

    <!-- Revenue Analytics (Compact) -->
    <div class="dash-block">
        <div class="dash-block-head">
            <span class="dash-block-title">Revenue Analytics</span>
            <span class="dash-badge-neutral" id="revenueChartBadge">Daily Trajectory</span>
        </div>
        <div class="dash-chart-box" style="height: 240px;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <!-- 2 Column Compact Grid: Top Stores/Recent Orders & Top Products -->
    <div class="dash-split-grid">
        <div class="dash-block" id="recentOrdersBlock" style="margin-bottom: 0;">
            <div class="dash-block-head">
                <span class="dash-block-title">Recent Orders</span>
                <span class="dash-badge-neutral">Latest Orders</span>
            </div>
            <div class="compact-list" id="recentOrdersList">
                <div class="empty-state">Loading recent orders...</div>
            </div>
        </div>

        <div class="dash-block" id="topSellersBlock" style="margin-bottom: 0;">
            <div class="dash-block-head">
                <span class="dash-block-title">Top Stores</span>
                <span class="dash-badge-neutral">By Revenue</span>
            </div>
            <div class="compact-list" id="topSellersList">
                <div class="empty-state">Loading stores...</div>
            </div>
        </div>

        <div class="dash-block" style="margin-bottom: 0;">
            <div class="dash-block-head">
                <span class="dash-block-title">Top Selling Products</span>
                <span class="dash-badge-neutral">By Volume</span>
            </div>
            <div class="compact-list" id="topProductsList">
                <div class="empty-state">Loading products...</div>
            </div>
        </div>
    </div>

    <!-- Top Riders -->
    <div class="dash-block" id="topRidersBlock" style="margin-top: 16px;">
        <div class="dash-block-head">
            <span class="dash-block-title">Top Riders</span>
            <span class="dash-badge-neutral">By Orders Delivered</span>
        </div>
        <div class="compact-list" id="topRidersList">
            <div class="empty-state">Loading riders...</div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/views-js/dashboard.js?v=@DateTime.Now.Ticks"></script>
    <script>
        lucide.createIcons();
    </script>
}
