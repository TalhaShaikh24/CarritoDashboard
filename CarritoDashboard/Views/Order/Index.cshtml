<div class="module" id="module-orders">

    <div class="module-header">
        <div class="search-bar flex-1">
            <i style="width: 20px;" data-lucide="search"></i>
            <input type="text" placeholder="Search by order ID, customer or phone..." id="orderSearch">
        </div>

        <div class="module-header-right">
            <select class="form-control" id="orderTypeFilter" style="min-width: 140px;">
                <option value="0">All Types</option>
                <option value="1">Online</option>
                <option value="2">InStore</option>
            </select>
            <select class="form-control" id="orderStatusFilter" style="min-width: 140px;">
                <option value="0">All Status</option>
                <option value="1">Pending</option>
                <option value="2">Confirmed</option>
                <option value="3">Rider Assigned</option>
                <option value="4">Out for Delivery</option>
                <option value="5">Delivered</option>
                <option value="6">Cancelled</option>
                <option value="7">Completed InStore</option>
            </select>
        </div>

    </div>
    <div class="table-container">
        <table class="data-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Store</th>
                    <th>Rider</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Order Detail Modal Template -->
<template id="orderDetailTemplate">
    <!-- Will be populated dynamically -->
</template>

@section scripts {
    <script src="~/views-js/orders.js"></script>
}