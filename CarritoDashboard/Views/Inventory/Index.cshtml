@{
    ViewData["Title"] = "Inventory Management";
}

<link href="~/css/file-uploader.css" rel="stylesheet" />

<div class="module" id="module-inventory">
    <div class="module-header">
        <div class="search-bar">
            <i style="width: 20px;" data-lucide="search"></i>
            <input type="text" placeholder="Search inventory..." id="inventorySearch">
        </div>

        <div class="module-header-right">
            <select class="form-control" id="filterStorekeeper" data-search="true" style="min-width: 170px;">
                <option value="">Loading Storekeepers...</option>
            </select>

            <select class="form-control" id="filterCategory" style="min-width: 140px;">
                <option value="All Categories">All Categories</option>
            </select>

            <select class="form-control" id="filterBrand" style="min-width: 140px;">
                <option value="All Brands">All Brands</option>
            </select>

            <button id="btnImportInventory" class="btn-outline">
                <i style="width: 18px;" data-lucide="upload"></i>
                Import
            </button>

            <button id="btnAddNewInventory" class="btn-primary">
                <i style="width: 18px;" data-lucide="plus"></i>
                Add Inventory
            </button>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="inventoryTable">
            <thead>
                <tr>
                    <th style="width: 60px;">Image</th>
                    <th>Product Title</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<style>
    /* Quick-add (Category / Brand) inside the Add & Edit inventory forms */
    .quick-add-link {
        float: right;
        font-size: 12px;
        font-weight: 600;
        color: #0aa64a;
        text-decoration: none;
        cursor: pointer;
    }

        .quick-add-link:hover {
            text-decoration: underline;
        }

    /* Centred popup for adding a new Category / Brand over the item form */
    .quick-add-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.5);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .quick-add-card {
        background: #ffffff;
        border-radius: 16px;
        width: min(440px, 92vw);
        max-height: 92vh;
        overflow: auto;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
    }

    .quick-add-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid #eef1ee;
    }

        .quick-add-card-header h3 {
            margin: 0;
            font-size: 17px;
        }

    .quick-add-close {
        background: none;
        border: none;
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        color: #6b7280;
    }

    .quick-add-card-body {
        padding: 18px 20px;
    }

    .quick-add-card-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 14px 20px;
        border-top: 1px solid #eef1ee;
    }
</style>

<template id="inventoryFormTemplate">
    <form id="frmInventory">
        <div class="form-row">
            <div class="form-group">
                <label>Title *</label>
                <input type="text" id="editInvTitle" class="form-control" required placeholder="Enter Title">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Category <a href="javascript:void(0);" class="quick-add-link" data-kind="category" data-target="editInvCategory">+ Add New</a></label>
                <select id="editInvCategory" class="form-control">
                    <option value="">Select Category</option>
                </select>
            </div>
            <div class="form-group col-md-6">
                <label>Brand <a href="javascript:void(0);" class="quick-add-link" data-kind="brand" data-target="editInvBrand">+ Add New</a></label>
                <select id="editInvBrand" class="form-control">
                    <option value="">Select Brand</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Type</label>
                <select id="editInvType" class="form-control" disabled>
                    <option value="1">Pack Item</option>
                    <option value="2">Catch Weight Item</option>
                </select>
            </div>
            <div class="form-group col-md-6">
                <label>Unit</label>
                <select id="editInvUnit" class="form-control">
                    <option value="">Select Unit</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-3">
                <label>Weight *</label>
                <input type="number" id="editInvWeight" class="form-control" min="0" step="0.01" required placeholder="Enter Weight">
            </div>
            <div class="form-group col-md-6">
                <label id="editInvPriceLabel">Price</label>
                <input type="number" id="editInvPrice" class="form-control" min="0" required placeholder="Enter Price">
            </div>
            <div class="form-group col-md-3">
                <label id="editInvPackSizeLabel">Pack Size</label>
                <input type="number" id="editInvPackSize" class="form-control" min="0" placeholder="Enter Pack Size">
            </div>
            <div class="form-group col-md-3">
                <label>Min Order Quantity *</label>
                <input type="number" id="editInvMinOrderQuantity" class="form-control" min="0" step="0.01" required placeholder="Enter Min Order Quantity">
            </div>
        </div>


        <div class="form-group">
            <label>Description</label>
            <textarea id="editInvDescription" class="form-control" rows="3" placeholder="Enter Description"></textarea>
        </div>

        <hr style="margin: 20px 0;">

        <div class="form-group">
            <label>Product Photo</label>
            <input type="file" id="editInvPhoto" accept="image/*">
            <small>Leave empty to keep current photo</small>
        </div>
    </form>
</template>

<!-- Quick-add popup: opens in the centre, over the Add / Edit item form -->
<div class="quick-add-overlay" id="quickAddOverlay" style="display: none;">
    <div class="quick-add-card">
        <div class="quick-add-card-header">
            <h3 id="quickAddTitle">Add New Category</h3>
            <button type="button" class="quick-add-close" id="quickAddClose">&times;</button>
        </div>
        <div class="quick-add-card-body">
            <div class="form-group">
                <label id="quickAddNameLabel">Category Name *</label>
                <input type="text" id="quickAddName" class="form-control" placeholder="Enter name" maxlength="50">
            </div>
            <div class="form-group" style="margin: 14px 0 0;">
                <label>Photo (Optional)</label>
                <input type="file" id="quickAddPhoto" accept="image/*">
            </div>
        </div>
        <div class="quick-add-card-footer">
            <button type="button" class="btn-outline" id="quickAddCancel">Cancel</button>
            <button type="button" class="btn-primary" id="quickAddSave">Add Category</button>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="~/views-js/inventory.js"></script>
    <script src="~/js/file-uploader.js"></script>
}