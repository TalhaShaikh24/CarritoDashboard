@{
    ViewData["Title"] = "Offers & Coupons";
}

<link href="~/css/offers-modern.css" rel="stylesheet" asp-append-version="true" />

<div class="module" id="module-offers">
    <!-- Top Metrics Overview -->
    <div class="offers-stats-row">
        <div class="offer-stat-card">
            <div class="offer-stat-icon total">
                <i data-lucide="ticket" style="width: 22px; height: 22px;"></i>
            </div>
            <div class="offer-stat-info">
                <span class="offer-stat-label">Total Coupons</span>
                <span class="offer-stat-value" id="statTotalCoupons">0</span>
            </div>
        </div>

        <div class="offer-stat-card">
            <div class="offer-stat-icon active">
                <i data-lucide="badge-percent" style="width: 22px; height: 22px;"></i>
            </div>
            <div class="offer-stat-info">
                <span class="offer-stat-label">Active Promos</span>
                <span class="offer-stat-value" id="statActiveCoupons">0</span>
            </div>
        </div>

        <div class="offer-stat-card">
            <div class="offer-stat-icon expired">
                <i data-lucide="clock-alert" style="width: 22px; height: 22px;"></i>
            </div>
            <div class="offer-stat-info">
                <span class="offer-stat-label">Expired / Inactive</span>
                <span class="offer-stat-value" id="statExpiredCoupons">0</span>
            </div>
        </div>

        <div class="offer-stat-card">
            <div class="offer-stat-icon redemptions">
                <i data-lucide="trending-up" style="width: 22px; height: 22px;"></i>
            </div>
            <div class="offer-stat-info">
                <span class="offer-stat-label">Total Redemptions</span>
                <span class="offer-stat-value" id="statTotalRedemptions">0</span>
            </div>
        </div>
    </div>

    <!-- Toolbar: Search, Filter Tabs & Actions -->
    <div class="offers-toolbar">
        <div class="offers-toolbar-left">
            <div class="offers-search-box">
                <i data-lucide="search"></i>
                <input type="text" id="offerSearchInput" placeholder="Search coupon code..." autocomplete="off">
                <button type="button" class="offers-search-clear" id="btnOfferSearchClear">&times;</button>
            </div>

            <div class="offers-filter-tabs">
                <button type="button" class="offers-tab-btn active" data-filter="all">All</button>
                <button type="button" class="offers-tab-btn" data-filter="active">Active</button>
                <button type="button" class="offers-tab-btn" data-filter="scheduled">Scheduled</button>
                <button type="button" class="offers-tab-btn" data-filter="expired">Expired</button>
            </div>
        </div>

        <div class="offers-toolbar-right">
            <div class="offers-view-toggle">
                <button type="button" class="offers-view-btn active" id="btnViewVouchers" title="Voucher Grid View">
                    <i data-lucide="layout-grid" style="width: 16px; height: 16px;"></i>
                </button>
                <button type="button" class="offers-view-btn" id="btnViewTable" title="Data Table View">
                    <i data-lucide="table" style="width: 16px; height: 16px;"></i>
                </button>
            </div>

            <button type="button" class="btn btn-outline" id="btnRefreshCoupons" title="Refresh from API">
                <i data-lucide="rotate-cw" style="width: 16px; height: 16px;"></i>
            </button>

            <button id="btnAddNewOffer" class="btn btn-primary" style="background: var(--pos-primary); border: none; padding: 9px 18px; font-weight: 700; border-radius: 10px; display: inline-flex; align-items: center; gap: 7px;">
                <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
                Create Coupon
            </button>
        </div>
    </div>

    <!-- View Mode 1: Voucher Cards Grid -->
    <div class="offers-vouchers-grid" id="offersVouchersGrid">
        <!-- Rendered dynamically -->
    </div>

    <!-- View Mode 2: Structured Data Table View -->
    <div class="offers-table-view" id="offersTableView">
        <table class="data-table" id="offersDataTable" style="width: 100%;">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Discount</th>
                    <th>Min. Order</th>
                    <th>Max. Cap</th>
                    <th>Validity Period</th>
                    <th>Usage (Used / Limit)</th>
                    <th>Target Customer</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody id="offersTableTbody">
                <!-- Rendered dynamically -->
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div class="offers-empty-state" id="offersEmptyState" style="display: none;">
        <i data-lucide="ticket-x"></i>
        <h3>No coupons found</h3>
        <p>No coupons match your filter or search query. Click "Create Coupon" to launch a new promotional offer.</p>
        <button type="button" class="btn btn-primary" id="btnEmptyCreateCoupon" style="background: #0aa64a; border: none; font-weight: 700; border-radius: 8px;">
            + Create First Coupon
        </button>
    </div>
</div>

<!-- =========================================================================
     MODAL TEMPLATE: Create / Edit Coupon
     ========================================================================= -->
<template id="couponModalTemplate">
    <form id="frmCouponModal" onsubmit="return false;" style="display: flex; flex-direction: column; gap: 14px;">
        <input type="hidden" id="modalCouponId" value="">

        <!-- Coupon Code with Generator -->
        <div class="form-group" style="margin-bottom: 0;">
            <label style="font-weight: 700;">Promo / Coupon Code <span class="text-danger">*</span></label>
            <div class="code-generator-wrap">
                <input type="text" id="modalCouponCode" class="form-control" placeholder="e.g. FLASH25, SAVE50" maxlength="30" required>
                <button type="button" class="btn-generate-code" id="btnGenerateRandomCode" title="Generate Random Code">
                    <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
                    Generate
                </button>
            </div>
            <small style="color: #64748b; font-size: 11px; margin-top: 3px;" id="codeHelpText">
                Customers enter this code at checkout to claim the discount.
            </small>
        </div>

        <!-- Discount Type Selector Pills -->
        <div class="form-group" style="margin-bottom: 0;">
            <label style="font-weight: 700;">Discount Type <span class="text-danger">*</span></label>
            <div class="disc-type-pills">
                <button type="button" class="disc-type-btn active" id="btnDiscTypePercent" data-type="1">
                    <i data-lucide="percent" style="width: 16px; height: 16px;"></i>
                    Percentage (%)
                </button>
                <button type="button" class="disc-type-btn" id="btnDiscTypeAmount" data-type="2">
                    <i data-lucide="banknote" style="width: 16px; height: 16px;"></i>
                    Flat Amount (Rs.)
                </button>
            </div>
        </div>

        <!-- Discount Value & Max Cap -->
        <div class="form-row">
            <div class="form-group">
                <label style="font-weight: 700;" id="lblDiscountValue">Discount Percentage (%) <span class="text-danger">*</span></label>
                <input type="number" id="modalDiscountValue" class="form-control" placeholder="e.g. 20" min="0.01" step="any" required>
            </div>
            <div class="form-group" id="groupMaxDiscount">
                <label style="font-weight: 700;">Max Discount Cap (Rs.)</label>
                <input type="number" id="modalMaxDiscount" class="form-control" placeholder="e.g. 500 (optional)" min="0" step="any">
            </div>
        </div>

        <!-- Min Order Value & Usage Limit -->
        <div class="form-row">
            <div class="form-group">
                <label style="font-weight: 700;">Min. Order Value (Rs.)</label>
                <input type="number" id="modalMinOrderValue" class="form-control" placeholder="e.g. 1000 (optional)" min="0" step="any">
            </div>
            <div class="form-group">
                <label style="font-weight: 700;">Total Usage Limit <span class="text-danger">*</span></label>
                <input type="number" id="modalUsageLimit" class="form-control" placeholder="e.g. 100" min="1" value="100" required>
            </div>
        </div>

        <!-- Validity Period (Start Date & Expiry Date) -->
        <div class="form-row">
            <div class="form-group">
                <label style="font-weight: 700;">Start Date <span class="text-danger">*</span></label>
                <input type="date" id="modalStartDate" class="form-control" required>
            </div>
            <div class="form-group">
                <label style="font-weight: 700;">Expiry Date <span class="text-danger">*</span></label>
                <input type="date" id="modalExpiryDate" class="form-control" required>
            </div>
        </div>

        <!-- Customer Targeting -->
        <div class="form-group" style="margin-bottom: 0;">
            <label style="font-weight: 700;">Target Audience</label>
            <select id="modalCustomerId" class="form-control">
                <option value="">All Customers (Public Promotion)</option>
                <!-- Populated dynamically from GET /api/Customer -->
            </select>
            <small style="color: #64748b; font-size: 11px; margin-top: 3px;">
                Leave as "All Customers" for general use, or assign to a specific customer.
            </small>
        </div>
    </form>
</template>

@section scripts {
    <script src="~/views-js/offers.js" asp-append-version="true"></script>
}
